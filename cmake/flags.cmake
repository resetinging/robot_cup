# DO NOT EDIT THIS FILE --- This file is a managed file, do not edit it directly.

set_target_properties(${CMAKE_PROJECT_NAME} PROPERTIES SUFFIX ".elf")

# ---------------------------------------------------------------------------
# 编译选项
# ---------------------------------------------------------------------------
target_compile_options(${CMAKE_PROJECT_NAME} PUBLIC
    ${CPU_FLAGS}
    -Wall
    $<$<CONFIG:Debug>:-Og>
    $<$<CONFIG:Debug>:-g3>
    $<$<CONFIG:Debug>:-ggdb>
    $<$<CONFIG:Debug>:-fstack-usage>
    $<$<CONFIG:Release>:-Os>
)

# ---------------------------------------------------------------------------
# 头文件搜索路径（对应 Keil 工程 IncludePath）
# ---------------------------------------------------------------------------
target_include_directories(${CMAKE_PROJECT_NAME} PUBLIC
    "${CMAKE_CURRENT_SOURCE_DIR}/Core/Inc"
    "${CMAKE_CURRENT_SOURCE_DIR}/Drivers/STM32F4xx_HAL_Driver/Inc"
    "${CMAKE_CURRENT_SOURCE_DIR}/Drivers/STM32F4xx_HAL_Driver/Inc/Legacy"
    "${CMAKE_CURRENT_SOURCE_DIR}/Drivers/CMSIS/Device/ST/STM32F4xx/Include"
    "${CMAKE_CURRENT_SOURCE_DIR}/Drivers/CMSIS/Include"
    "${CMAKE_CURRENT_SOURCE_DIR}/Hardware"
    "${CMAKE_CURRENT_SOURCE_DIR}/Software"
    "${CMAKE_CURRENT_SOURCE_DIR}/Software/Navigation"
    "${CMAKE_CURRENT_SOURCE_DIR}/Task"
)

# ---------------------------------------------------------------------------
# 宏定义（对应 Keil 工程 Define）
# ---------------------------------------------------------------------------
target_compile_definitions(${CMAKE_PROJECT_NAME} PUBLIC
    USE_HAL_DRIVER
    STM32F407xx
    $<$<CONFIG:Debug>:DEBUG>
)

# ---------------------------------------------------------------------------
# 链接选项
# ---------------------------------------------------------------------------
target_link_options(${CMAKE_PROJECT_NAME} PUBLIC
    ${CPU_FLAGS}
    -T${CMAKE_CURRENT_SOURCE_DIR}/STM32F407VGTX_FLASH.ld
    -Wl,-Map=${CMAKE_PROJECT_NAME}.map,--cref
    -Wl,--gc-sections
    -Wl,--print-memory-usage
    -Wl,--no-warn-rwx-segments
    --specs=nano.specs
    --specs=nosys.specs
    -u _printf_float
)

# 数学库（必须用 target_link_libraries 才能排在目标文件之后，否则 asin/atan2
# 等符号会因为静态库链接顺序问题解析失败）
target_link_libraries(${CMAKE_PROJECT_NAME} PUBLIC m)

# 清理时一并删除 map 文件
set_property(DIRECTORY APPEND PROPERTY ADDITIONAL_CLEAN_FILES
    "${CMAKE_CURRENT_BINARY_DIR}/${CMAKE_PROJECT_NAME}.map")
